{
  "manifest_version": 3,
  "name": "Headroom helper",
  "version": "1.0.0",
  "description": "Tells the Headroom app which tabs use which Chrome process, so it can show memory per tab. Never reads page content.",
  "key": "",
  "permissions": ["tabs", "webNavigation", "sessions", "nativeMessaging", "alarms", "storage"],
  "background": { "service_worker": "sw.js" },
  "incognito": "spanning",
  "minimum_chrome_version": "120"
}
